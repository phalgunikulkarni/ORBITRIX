import 'dart:async';

import 'package:flutter/material.dart';
import 'package:google_maps_flutter/google_maps_flutter.dart';
import 'package:location/location.dart';

// import 'route_tracking_screen.dart'; // TODO: Migrate route_tracking_screen to Google Maps
import 'widgets/google_maps_widget.dart';
import 'config/maps_config.dart';
import 'services/bangalore_locations_service.dart';
import 'services/movement_detection_service.dart';

class DashboardScreenGoogleMaps extends StatefulWidget {
  const DashboardScreenGoogleMaps({super.key});

  @override
  State<DashboardScreenGoogleMaps> createState() => _DashboardScreenGoogleMapsState();
}

class _DashboardScreenGoogleMapsState extends State<DashboardScreenGoogleMaps> {
  int _selectedIndex = 0;
  GoogleMapController? _mapController;
  LatLng _currentPosition = LatLng(
    MapsConfig.DEFAULT_LAT,
    MapsConfig.DEFAULT_LNG,
  );

  Set<Marker> _markers = {};
  bool gpsOn = true;
  bool bluetoothConnected = true;
  bool _hasLocationPermission = false;
  bool _shouldDetectVehicles = false; // Movement detection flag
  late MovementDetectionService _movementDetectionService;
  
  // Search variables
  TextEditingController _searchController = TextEditingController();
  List<BangaloreLocation> _searchResults = [];
  bool _showSearchResults = false;
  LatLng? _searchedLocation;

  @override
  void initState() {
    super.initState();
    _movementDetectionService = MovementDetectionService();
    // Just check permission, don't auto-center
    WidgetsBinding.instance.addPostFrameCallback((_) {
      _checkLocationPermission();
      _startMovementDetection();
    });
  }

  @override
  void dispose() {
    _mapController?.dispose();
    _searchController.dispose();
    _movementDetectionService.stopMonitoring();
    super.dispose();
  }

  /// Start monitoring vehicle movement
  void _startMovementDetection() {
    _movementDetectionService.startMonitoring();
    
    // Listen to movement status changes
    _movementDetectionService.movementStatusStream.listen(
      (canDetect) {
        setState(() {
          _shouldDetectVehicles = canDetect;
        });
        
        if (!canDetect) {
          // Clear vehicle markers when stopped or indoors
          _clearVehicleMarkers();
        }
      },
    );
  }

  /// Clear all vehicle markers (but keep other markers like search location)
  void _clearVehicleMarkers() {
    setState(() {
      _markers.removeWhere((marker) => 
        marker.markerId.value.startsWith('ble_') || 
        marker.markerId.value.startsWith('vehicle_')
      );
    });
  }

  Future<void> _checkLocationPermission() async {
    // Location is REQUIRED - app cannot work without it
    final loc = Location();
    try {
      bool serviceEnabled = await loc.serviceEnabled();
      if (!serviceEnabled) {
        serviceEnabled = await loc.requestService();
        if (!serviceEnabled) {
          setState(() {
            gpsOn = false;
            _hasLocationPermission = false;
          });
          return;
        }
      }

      PermissionStatus permissionGranted = await loc.hasPermission();
      if (permissionGranted == PermissionStatus.denied) {
        permissionGranted = await loc.requestPermission();
        if (permissionGranted != PermissionStatus.granted) {
          setState(() {
            gpsOn = false;
            _hasLocationPermission = false;
          });
          return;
        }
      }

      setState(() {
        gpsOn = true;
        _hasLocationPermission = true;
      });
      await _getUserLocation();
    } catch (e) {
      print('Location error: $e');
      setState(() {
        gpsOn = false;
        _hasLocationPermission = false;
      });
    }
  }

  Future<void> _getUserLocation() async {
    if (!mounted) return;

    final loc = Location();
    try {
      final userLocation = await loc.getLocation();
      if (!mounted) return;

      final lat = userLocation.latitude;
      final lon = userLocation.longitude;

      if (lat != null && lon != null) {
        final newPosition = LatLng(lat, lon);
        
        // Just update the position, don't move camera
        setState(() {
          _currentPosition = newPosition;
          gpsOn = true;
          _hasLocationPermission = true;
        });
        
        print('Current location detected: $newPosition'); // Debug
      } else {
        print('Location latitude or longitude is null');
      }
    } catch (e) {
      print('Error getting location: $e');
      setState(() => gpsOn = false);
    }
  }

  void _onItemTapped(int index) {
    setState(() => _selectedIndex = index);
  }

  // Search for Bangalore locations
  void _searchLocations(String input) {
    final results = BangaloreLocationsService.searchLocations(input);
    setState(() {
      _searchResults = results;
      _showSearchResults = results.isNotEmpty;
    });
  }

  // Select a Bangalore location
  void _selectLocation(BangaloreLocation location) {
    setState(() {
      _searchedLocation = location.coordinates;
      _showSearchResults = false;
      _searchController.clear();
      _searchResults = [];
    });

    // Animate camera to location
    if (_mapController != null) {
      _mapController!.animateCamera(
        CameraUpdate.newCameraPosition(
          CameraPosition(
            target: location.coordinates,
            zoom: 15,
          ),
        ),
      );
    }

    // Add marker for searched location
    final marker = Marker(
      markerId: const MarkerId('search_location'),
      position: location.coordinates,
      infoWindow: InfoWindow(
        title: location.name,
        snippet: location.description,
      ),
      icon: BitmapDescriptor.defaultMarkerWithHue(BitmapDescriptor.hueOrange),
    );

    setState(() {
      _markers.removeWhere((m) => m.markerId.value == 'search_location');
      _markers.add(marker);
    });
  }

  // Add BLE marker - only if vehicle is moving and outdoors
  void addBleMarker(String id, LatLng position, {String? label}) {
    // Don't add vehicle markers if vehicle is stopped or indoors
    if (!_shouldDetectVehicles) {
      print('Vehicle detection disabled: Vehicle stopped or indoors');
      return;
    }

    final marker = Marker(
      markerId: MarkerId('ble_$id'),
      position: position,
      infoWindow: InfoWindow(
        title: label ?? 'Vehicle $id',
      ),
      icon: BitmapDescriptor.defaultMarkerWithHue(BitmapDescriptor.hueBlue),
    );
    setState(() => _markers.add(marker));
  }

  // Remove BLE marker
  void removeBleMarker(String id) {
    setState(() {
      _markers.removeWhere((marker) => marker.markerId.value == 'ble_$id');
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('V2V Safety Dashboard'),
        centerTitle: true,
        actions: [
          Padding(
            padding: const EdgeInsets.all(8.0),
            child: Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Chip(
                    label: Text(
                      gpsOn ? 'GPS: ON' : 'GPS: OFF',
                      style: const TextStyle(
                        color: Colors.white,
                        fontWeight: FontWeight.bold,
                        fontSize: 12,
                      ),
                    ),
                    backgroundColor: gpsOn ? Colors.green : Colors.grey,
                    padding: const EdgeInsets.symmetric(horizontal: 8),
                  ),
                  const SizedBox(height: 4),
                  Chip(
                    label: Text(
                      _shouldDetectVehicles ? 'Detection: ON' : 'Detection: OFF',
                      style: const TextStyle(
                        color: Colors.white,
                        fontWeight: FontWeight.bold,
                        fontSize: 12,
                      ),
                    ),
                    backgroundColor: _shouldDetectVehicles ? Colors.green : Colors.orange,
                    padding: const EdgeInsets.symmetric(horizontal: 8),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
      body: Padding(
        padding: const EdgeInsets.all(8.0),
        child: Column(
          children: [
            // Status bar showing movement status
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 8.0, vertical: 4.0),
              child: Row(
                children: [
                  Icon(
                    _shouldDetectVehicles ? Icons.directions_car : Icons.directions_walk,
                    color: _shouldDetectVehicles ? Colors.green : Colors.orange,
                  ),
                  const SizedBox(width: 8),
                  Expanded(
                    child: Text(
                      _shouldDetectVehicles
                          ? 'Vehicle moving & outdoors - Detection ACTIVE'
                          : _movementDetectionService.isIndoor
                              ? 'Inside building - Detection disabled'
                              : 'Vehicle stopped - Detection disabled',
                      style: TextStyle(
                        fontSize: 13,
                        fontWeight: FontWeight.w500,
                        color: _shouldDetectVehicles ? Colors.green : Colors.orange,
                      ),
                    ),
                  ),
                ],
              ),
            ),
            
            // Search Bar
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 8.0),
              child: TextField(
                controller: _searchController,
                decoration: InputDecoration(
                  hintText: 'Search location...',
                  prefixIcon: const Icon(Icons.search),
                  suffixIcon: _searchController.text.isNotEmpty
                      ? IconButton(
                          icon: const Icon(Icons.clear),
                          onPressed: () {
                            _searchController.clear();
                            setState(() {
                              _searchResults = [];
                              _showSearchResults = false;
                            });
                          },
                        )
                      : null,
                  border: OutlineInputBorder(
                    borderRadius: BorderRadius.circular(8),
                  ),
                  contentPadding: const EdgeInsets.symmetric(
                    vertical: 12,
                    horizontal: 8,
                  ),
                ),
                onChanged: (value) {
                  setState(() {});
                  _searchLocations(value);
                },
              ),
            ),
            // Search Results Dropdown
            if (_showSearchResults && _searchResults.isNotEmpty)
              Container(
                margin: const EdgeInsets.symmetric(horizontal: 8.0, vertical: 4.0),
                decoration: BoxDecoration(
                  border: Border.all(color: Colors.grey.shade300),
                  borderRadius: BorderRadius.circular(8),
                  color: Colors.white,
                ),
                constraints: const BoxConstraints(maxHeight: 200),
                child: ListView.builder(
                  itemCount: _searchResults.length,
                  itemBuilder: (context, index) {
                    final location = _searchResults[index];
                    return ListTile(
                      leading: const Icon(Icons.location_on, size: 20, color: Colors.orange),
                      title: Text(location.name, maxLines: 1, overflow: TextOverflow.ellipsis),
                      subtitle: Text(location.description, maxLines: 1, overflow: TextOverflow.ellipsis),
                      onTap: () => _selectLocation(location),
                    );
                  },
                ),
              ),
            Expanded(
              child: Container(
                decoration: BoxDecoration(
                  border: Border.all(color: Colors.grey.shade300),
                  borderRadius: BorderRadius.circular(12),
                  boxShadow: [
                    BoxShadow(
                      color: Colors.black.withOpacity(0.1),
                      blurRadius: 8,
                    ),
                  ],
                ),
                child: ClipRRect(
                  borderRadius: BorderRadius.circular(12),
                  child: GoogleMapsWidget(
                    // Always show Bangalore on startup
                    initialPosition: LatLng(
                      MapsConfig.DEFAULT_LAT,
                      MapsConfig.DEFAULT_LNG,
                    ),
                    markers: {
                      ..._markers,
                      Marker(
                        markerId: const MarkerId('current_position'),
                        position: _currentPosition,
                        infoWindow: const InfoWindow(title: 'Your Location'),
                        icon: BitmapDescriptor.defaultMarkerWithHue(BitmapDescriptor.hueCyan),
                      ),
                    },
                    onMapCreated: (controller) {
                      _mapController = controller;
                      // Just save controller, don't animate
                    },
                    zoomControlsEnabled: true,
                    compassEnabled: true,
                  ),
                ),
              ),
            ),
            Padding(
              padding: const EdgeInsets.only(top: 12.0),
              child: Row(
                children: [
                  // TODO: Migrate RouteTrackingScreen to Google Maps (currently uses flutter_map)
                  // Expanded(
                  //   child: ElevatedButton.icon(
                  //     onPressed: () {
                  //       Navigator.push(
                  //         context,
                  //         MaterialPageRoute(
                  //           builder: (context) => const RouteTrackingScreen(),
                  //         ),
                  //       );
                  //     },
                  //     icon: const Icon(Icons.play_arrow),
                  //     label: const Text('Start Tracking'),
                  //   ),
                  // ),
                  // const SizedBox(width: 8),
                  Expanded(
                    child: ElevatedButton.icon(
                      onPressed: () {
                        _mapController?.animateCamera(
                          CameraUpdate.newCameraPosition(
                            CameraPosition(
                              target: _currentPosition,
                              zoom: 16,
                            ),
                          ),
                        );
                      },
                      icon: const Icon(Icons.location_on),
                      label: const Text('Center Map'),
                    ),
                  ),
                ],
              ),
            ),
            if (!_hasLocationPermission && !gpsOn)
              Padding(
                padding: const EdgeInsets.only(top: 8.0),
                child: Container(
                  padding: const EdgeInsets.all(12),
                  decoration: BoxDecoration(
                    color: Colors.red[100],
                    borderRadius: BorderRadius.circular(8),
                  ),
                  child: Row(
                    children: [
                      Icon(Icons.error, color: Colors.red[800]),
                      const SizedBox(width: 8),
                      Expanded(
                        child: Text(
                          'Location services required. Please enable location and grant permissions.',
                          style: TextStyle(color: Colors.red[800]),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
          ],
        ),
      ),
      bottomNavigationBar: NavigationBar(
        selectedIndex: _selectedIndex,
        onDestinationSelected: _onItemTapped,
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.dashboard),
            label: 'Dashboard',
          ),
          NavigationDestination(
            icon: Icon(Icons.info),
            label: 'Info',
          ),
          NavigationDestination(
            icon: Icon(Icons.settings),
            label: 'Settings',
          ),
        ],
      ),
    );
  }
}
